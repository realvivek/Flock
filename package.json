{
  "name": "flock-anatomy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive 3D anatomy of a Flock Safety license plate reader: the hardware, the install, and the data path.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:sources && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check:sources": "tsx scripts/check-sources.ts",
    "check:links": "tsx scripts/check-links.ts",
    "models": "python3 tools/blender/build_all.py && npm run models:optimize",
    "models:optimize": "tsx scripts/optimize-models.ts",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "stills": "python3 tools/blender/render_stills.py public/stills manifest"
  },
  "dependencies": {
    "@babylonjs/core": "^9.25.0",
    "@babylonjs/loaders": "^9.25.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "d3-array": "^3.2.4",
    "d3-ease": "^3.0.1",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.25.0",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@playwright/test": "^1.62.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo-projection": "^4.0.0",
    "mapshaper": "^0.7.80",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
