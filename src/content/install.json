  "paths": {
    "solar": {
      "label": "Solar + battery",
      "summary": "DC only. Panel to battery box, battery box to the camera's rear connector. No conductor reaches the ground.",
      "facts": [
        {
          "k": "Panel",
          "v": "18-20 V dual array on the pole top",
          "sources": [
            "flock-techspecs"
          ]
        },
        {
          "k": "Battery",
          "v": "10.8 V / 19 Ah lithium-ion in an external box; Bluetooth health telemetry",
          "sources": [
            "cehrp-dissection",
            "ryanohoro-2024"
          ]
        },
        {
          "k": "Cables",
          "v": "Panel-to-battery and battery-to-camera DC leads; billed as replacement cables at $50",
          "sources": [
            "flock-fee-schedule"
          ]
        },
        {
          "k": "Data",
          "v": "No data conductor; all data is transmitted over LTE",
          "sources": [
            "flock-techspecs",
            "cehrp-dissection"
          ]
        },
        {
          "k": "Unknown",
          "v": "Panel wattage, camera draw in watts, and battery runtime in days are not published",
          "sources": [
            "flock-techspecs"
          ]
        }
      ]
    },
    "ac": {
      "label": "120 V AC kit",
      "summary": "Mains from the customer's supply into a Flock junction box, stepped down to DC for the same rear connector.",
      "facts": [
        {
          "k": "Supply",
          "v": "120 V AC, landed by the customer's licensed electrician",
          "sources": [
            "flock-impl-guide"
          ]
        },
        {
          "k": "Junction box",
          "v": "Flock-supplied, with indicator lights for diagnostics",
          "sources": [
            "flock-impl-guide"
          ]
        },
        {
          "k": "Kit",
          "v": "AC power kit $150 replacement; DC power kit also listed",
          "sources": [
            "flock-fee-schedule"
          ]
        },
        {
          "k": "Data path",
          "v": "AC changes the power source; the uplink remains LTE",
          "sources": [
            "flock-techspecs"
          ]
        }
      ]
    },
    "wing": {
      "label": "Wing gateway · PoE · SFP",
      "summary": "The configuration in which Ethernet, PoE and fiber are used. An agency's existing cameras stream RTSP to a Wing Gateway in the network closet, which runs the Vehicle Fingerprint models and forwards results to Flock's cloud.",
      "facts": [
        {
          "k": "Gateway",
          "v": "Wing Gateway 2.0: 8, 16 or 32 streams; $300 to $1,000 per year plus per-stream software",
          "sources": [
            "flock-catalog-2024",
            "flock-video-webinar"
          ]
        },
        {
          "k": "Camera side",
          "v": "Any RTSP camera on PoE; CAT6 to a PoE switch",
          "sources": [
            "flock-video-webinar",
            "flock-wing-2020"
          ]
        },
        {
          "k": "Uplink",
          "v": "Switch SFP port with a fiber or copper module to the closet; then the city's internet to Flock",
          "sources": [
            "flock-video-webinar"
          ]
        },
        {
          "k": "What Wing extracts",
          "v": "Plate, state, make, type, color, roof racks, bumper stickers, aftermarket wheels, trailer hitch, window decals, body damage",
          "sources": [
            "flock-wing-2020"
          ]
        },
        {
          "k": "Also on the pole",
          "v": "Condor video cameras use a Flock SIM or AC; solar Condor and Falcon can share one pole",
          "sources": [
            "flock-catalog-2024",
            "police1-condor"
          ]
        }
      ]
    }
  }
